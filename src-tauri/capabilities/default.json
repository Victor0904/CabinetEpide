{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacités de la fenêtre principale et des fenêtres secondaires (projection, consultation)",
  "windows": ["main", "projection-*", "consultation-*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-create",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:default"
  ]
}
